rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Catálogo admin (categorías, marcas, banners)
    match /categories/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Productos del vendedor
    match /products/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Fotos de perfil (comprador / vendedor)
    match /users/{userId}/profile/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Historias
    match /stories/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Restaurantes (menú, logo, etc.)
    match /restaurants/{restaurantId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Vehículos (módulo /autos)
    match /vehicles/{userId}/{listingId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Propiedades (Zona Prop) — fotos y videos
    match /properties/{userId}/{listingId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Adjuntos de reclamos (fotos y comprobantes)
    match /claims/{claimId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Cualquier otra ruta: solo lectura pública
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
