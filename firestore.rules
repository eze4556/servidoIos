rules_version = '2';
// Reglas oficiales Servido — pegar en Firebase Console → Firestore → Rules
// o: firebase deploy --only firestore:rules --project servidodb-a1eda
//
// Admin SDK (APIs /api/*) BYPASSEA estas reglas.
// Colecciones solo-servidor: denegadas al cliente a propósito.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function userExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()));
    }

    function isAdmin() {
      return userExists() && userDoc().role == 'admin';
    }

    function isSeller() {
      return userExists() && userDoc().role == 'seller';
    }

    function isCadete() {
      return userExists() && userDoc().role == 'cadete';
    }

    function isApprovedCadete() {
      return isCadete()
        && userDoc().status == 'approved'
        && userDoc().isActive == true;
    }

    function isRestaurantOwner() {
      return isSeller() && userDoc().businessType == 'restaurant';
    }

    function myRestaurantId() {
      return userExists() && 'restaurantId' in userDoc()
        ? userDoc().restaurantId
        : uid();
    }

    function isChatParticipant() {
      return signedIn() && (
        uid() in resource.data.participantIds
        || resource.data.buyerId == uid()
        || resource.data.sellerId == uid()
      );
    }

    function isChatParticipantCreate() {
      return signedIn() && (
        uid() in request.resource.data.participantIds
        || request.resource.data.buyerId == uid()
        || request.resource.data.sellerId == uid()
      );
    }

    // ─── users ─────────────────────────────────────────────────
    // Lectura autenticada: catálogo/seller profiles + paneles actuales
    // (buyer/seller hacen listados). No exponer sin auth.
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && uid() == userId
        && request.resource.data.role in ['user', 'seller', 'cadete']
        && request.resource.data.uid == userId;

      // Dueño edita perfil; no puede tocar role / isActive / productUploadLimit
      allow update: if isAdmin()
        || (
          signedIn()
          && uid() == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'isActive', 'productUploadLimit'])
        );

      allow delete: if isAdmin();
    }

    // ─── Catálogo público ──────────────────────────────────────
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alerts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offerAlerts/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && isSeller()
        && request.resource.data.sellerId == uid();
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.sellerId == uid());
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == uid();
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.userId == uid());
    }

    match /questions/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == uid();
      // Comprador crea; vendedor responde; admin todo
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == uid())
        || (signedIn() && isSeller());
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == uid());
    }

    // ─── Favoritos / follows ───────────────────────────────────
    match /favorites/{id} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow delete: if signedIn() && resource.data.userId == uid();
      allow update: if false;
    }

    match /follows/{id} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow delete: if signedIn() && resource.data.userId == uid();
      allow update: if false;
    }

    // ─── Historias ─────────────────────────────────────────────
    match /stories/{id} {
      allow read: if resource.data.isActive == true
        || (signedIn() && resource.data.authorId == uid())
        || isAdmin();
      allow create: if signedIn()
        && request.resource.data.authorId == uid();
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.authorId == uid());
    }

    // ─── Autos / propiedades ───────────────────────────────────
    match /vehicleListings/{listingId} {
      allow read: if resource.data.status == 'active'
        || (signedIn() && resource.data.sellerId == uid())
        || isAdmin();
      allow create: if signedIn()
        && request.resource.data.sellerId == uid()
        && request.resource.data.status in ['active', 'paused'];
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.sellerId == uid());
    }

    match /propertyListings/{listingId} {
      allow read: if resource.data.status == 'active'
        || (signedIn() && resource.data.sellerId == uid())
        || isAdmin();
      allow create: if signedIn()
        && request.resource.data.sellerId == uid()
        && request.resource.data.status in ['active', 'paused'];
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.sellerId == uid());
    }

    // ─── Cupones ───────────────────────────────────────────────
    match /coupons/{id} {
      allow read: if resource.data.isActive == true
        || (signedIn() && resource.data.sellerId == uid())
        || isAdmin();
      allow create: if isAdmin()
        || (signedIn() && isSeller() && request.resource.data.sellerId == uid());
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.sellerId == uid());
    }

    // ─── Compras marketplace ───────────────────────────────────
    // NOTA: paneles seller/admin hacen listados amplios hoy.
    // Sellers autenticados pueden leer compras (filtrar en cliente).
    // Ideal futuro: API admin o ventas desnormalizadas por vendedor.
    match /purchases/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.buyerId == uid())
        || isSeller();
      allow create: if false; // solo Admin SDK / server
      allow update: if isAdmin()
        || (signedIn() && resource.data.buyerId == uid())
        || isSeller();
      allow delete: if isAdmin();
    }

    match /centralizedPurchases/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.compradorId == uid())
        || isSeller();
      allow create: if false;
      allow update: if isAdmin() || isSeller();
      allow delete: if isAdmin();
    }

    match /centralizedShipments/{id} {
      allow read: if isAdmin()
        || (signedIn() && (
          resource.data.vendorId == uid()
          || resource.data.buyerId == uid()
        ));
      allow create, update: if isAdmin()
        || (signedIn() && resource.data.vendorId == uid())
        || (signedIn() && request.resource.data.vendorId == uid());
      allow delete: if isAdmin();
    }

    match /sellerBankConfigs/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.vendedorId == uid());
      allow create, update: if isAdmin()
        || (signedIn() && request.resource.data.vendedorId == uid());
      allow delete: if isAdmin();
    }

    match /manualPayments/{id} {
      allow read, write: if isAdmin();
    }

    match /paymentHistory/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.vendedorId == uid());
      allow write: if isAdmin();
    }

    // ─── Chats ─────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAdmin() || isChatParticipant();

      allow create: if isChatParticipantCreate();

      allow update: if isAdmin() || isChatParticipant();

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function canAccessParent() {
          return signedIn() && (
            isAdmin()
            || uid() in parentChat().participantIds
            || parentChat().buyerId == uid()
            || parentChat().sellerId == uid()
          );
        }

        allow read: if canAccessParent();
        allow create: if canAccessParent()
          && request.resource.data.senderId == uid();
        allow update, delete: if isAdmin();
      }
    }

    // ─── Notificaciones ────────────────────────────────────────
    match /notifications/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == uid());
      // Varios flujos cliente crean notifs para otro user (pedido, chat, etc.)
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['userId']);
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == uid());
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == uid());
    }

    // ─── Restaurantes / menú ───────────────────────────────────
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if signedIn()
        && (
          request.resource.data.ownerId == uid()
          || restaurantId == uid()
        );
      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerId == uid())
        || (signedIn() && restaurantId == myRestaurantId());
      allow delete: if isAdmin();
    }

    match /menuCategories/{id} {
      allow read: if true;
      allow create: if isRestaurantOwner()
        && request.resource.data.restaurantId == myRestaurantId();
      allow update, delete: if isAdmin()
        || (isRestaurantOwner() && resource.data.restaurantId == myRestaurantId());
    }

    match /menuItems/{id} {
      allow read: if true;
      allow create: if isRestaurantOwner()
        && request.resource.data.restaurantId == myRestaurantId();
      allow update, delete: if isAdmin()
        || (isRestaurantOwner() && resource.data.restaurantId == myRestaurantId());
    }

    match /menuPromotions/{id} {
      allow read: if true;
      allow create: if isRestaurantOwner()
        && request.resource.data.restaurantId == myRestaurantId();
      allow update, delete: if isAdmin()
        || (isRestaurantOwner() && resource.data.restaurantId == myRestaurantId());
    }

    // ─── Pedidos comida ────────────────────────────────────────
    // Pool cadete: query status in [listo,despachado] + payment approved
    // (ver lib/cadete-orders.ts). Cadete aprobado puede leer esos + los suyos.
    match /foodOrders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.buyerId == uid())
        || (signedIn() && resource.data.restaurantOwnerId == uid())
        || (signedIn() && resource.data.restaurantId == myRestaurantId())
        || (signedIn() && resource.data.cadeteId == uid())
        || (
          isApprovedCadete()
          && resource.data.paymentStatus == 'approved'
          && resource.data.status in ['listo', 'despachado', 'en_camino', 'llegando', 'afuera']
        );

      // Creación vía Admin SDK / server preferible; si el client escribe, buyer dueño
      allow create: if signedIn()
        && request.resource.data.buyerId == uid();

      allow update: if isAdmin()
        || (signedIn() && resource.data.restaurantOwnerId == uid())
        || (signedIn() && resource.data.restaurantId == myRestaurantId())
        || (signedIn() && resource.data.buyerId == uid())
        || (
          // Cadete reclama pedido libre del pool
          isApprovedCadete()
          && resource.data.cadeteId == null
          && request.resource.data.cadeteId == uid()
          && resource.data.status in ['listo', 'despachado']
        )
        || (
          // Cadete avanza su pedido asignado
          isApprovedCadete()
          && resource.data.cadeteId == uid()
        );

      allow delete: if isAdmin();
    }

    // ─── Liquidaciones delivery (lectura propia; escritura Admin SDK) ─
    match /cadetePayoutBatches/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.cadeteId == uid());
      allow write: if false;
    }

    match /restaurantCommissionBatches/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.restaurantId == myRestaurantId())
        || (signedIn() && resource.data.ownerId == uid());
      allow write: if false;
    }

    // ─── Pricing delivery (lectura pública; edit manual/console o admin) ─
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Servicios / turnos ────────────────────────────────────
    match /serviceAppointments/{id} {
      allow read: if isAdmin()
        || (signedIn() && (
          resource.data.buyerId == uid()
          || resource.data.sellerId == uid()
        ));
      allow create: if signedIn()
        && request.resource.data.buyerId == uid();
      allow update: if isAdmin()
        || (signedIn() && (
          resource.data.buyerId == uid()
          || resource.data.sellerId == uid()
        ));
      allow delete: if isAdmin();
    }

    match /serviceSlotLocks/{id} {
      allow read: if signedIn();
      allow write: if signedIn(); // locks anti-doble reserva desde client/API
    }

    // ─── Reseller ──────────────────────────────────────────────
    match /resellerLinks/{id} {
      allow read: if signedIn()
        && (
          isAdmin()
          || resource.data.referrerUserId == uid()
          || resource.data.sellerId == uid()
        );
      allow write: if false; // Admin SDK
    }

    match /resellerSales/{id} {
      allow read: if signedIn()
        && (
          isAdmin()
          || resource.data.referrerUserId == uid()
          || resource.data.sellerId == uid()
        );
      allow write: if false;
    }

    match /resellerStats/{userId} {
      allow read: if signedIn() && (isAdmin() || uid() == userId);
      allow write: if false;
    }

    match /resellerPayoutBatches/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.referrerUserId == uid());
      allow write: if false;
    }

    // ─── Suscripciones (lectura propia; write server) ──────────
    match /subscriptionPricing/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptionPricingHistory/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /subscriptions/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == uid());
      allow write: if false;
    }

    match /subscriptionPreapprovals/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == uid());
      allow write: if false;
    }

    match /transactions/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == uid());
      allow write: if false;
    }

    // ─── Solo servidor (Admin SDK) — denegar cliente ───────────
    match /pending_purchases/{id} {
      allow read, write: if false;
    }
    match /failed_purchases/{id} {
      allow read, write: if false;
    }
    match /checkoutSessions/{id} {
      allow read, write: if false;
    }
    match /mercadopagoOAuthStates/{id} {
      allow read, write: if false;
    }
    match /mercadopagoWebhookEvents/{id} {
      allow read, write: if false;
    }

    // Test de conectividad legacy
    match /test/{id} {
      allow read, write: if isAdmin();
    }

    // Deny-by-default para cualquier otra colección nueva
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
