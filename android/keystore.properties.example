# Plantilla de las credenciales de firma.
#
# Copiar como android/keystore.properties (ese nombre está en .gitignore) y
# completar con los datos reales. Sin este archivo el build de release sale sin
# firmar, y Play Store rechaza los AAB sin firma.
#
# storeFile conviene apuntarlo a una ruta absoluta fuera del repo, así el
# keystore no depende de la carpeta del proyecto ni se cuela en un commit.

storeFile=D:/servido-keys/servido-upload.jks
storePassword=CAMBIAR
keyAlias=servido
keyPassword=CAMBIAR
