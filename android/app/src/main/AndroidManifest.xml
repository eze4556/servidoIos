<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Valores por defecto de FCM. Aplican cuando la notificación llega con
            la app cerrada o en segundo plano: en ese caso la dibuja el SDK, sin
            pasar por el código JavaScript, así que el ícono, el color y el canal
            tienen que estar declarados acá o Android usa el ícono de la app
            (que sale como un cuadrado blanco) y un canal sin sonido.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_servido" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/servido_notification" />
        <!-- Debe coincidir con ANDROID_CHANNEL_ID en lib/push/constants.ts. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="servido_default" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Ubicación aproximada y precisa para @capacitor/geolocation. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        Android 13+ exige pedir este permiso en runtime para poder mostrar
        notificaciones; lo dispara PushNotifications.requestPermissions().
        Se declara acá y no se deja a la librería de Firebase para no depender de
        su versión.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
