<?xml version="1.0" encoding="utf-8"?>
<!--
  Pegar estas líneas dentro de android/app/src/main/AndroidManifest.xml
  (dentro de <manifest>, ANTES de <application>), después de:
    npx cap add android
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ubicación cadete: tracking en entrega -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 10+: seguir compartiendo con la app en segundo plano (pedido activo) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
</manifest>
