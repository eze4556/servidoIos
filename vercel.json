{
  "installCommand": "npm install --legacy-peer-deps",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/subscription/expire",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/delivery-settlements",
      "schedule": "0 12 * * 2"
    },
    {
